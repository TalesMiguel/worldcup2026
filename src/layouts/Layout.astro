---
interface Props {
  title: string;
  description?: string;
}

const { title, description = 'FIFA World Cup 2026 stats tracker' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <title>{title} · WC 2026</title>
    <script is:inline>
      (function() {
        var lang = localStorage.getItem('lang') || 'en';
        document.documentElement.setAttribute('data-lang', lang);
      })();
    </script>
  </head>
  <body class="bg-night-900 text-white min-h-screen font-sans antialiased">
    <header class="border-b border-night-700 bg-night-800/80 backdrop-blur-sm sticky top-0 z-50">
      <nav class="px-6 h-14 flex items-center gap-6">
        <a href={`${base}/`} class="flex items-center gap-2 font-bold text-white hover:text-fifa-green transition-colors">
          <span class="text-fifa-gold text-xl">⚽</span>
          <span class="text-sm tracking-wide uppercase">WC 2026</span>
        </a>
        <div class="flex items-center gap-1 ml-2">
          <a href={`${base}/`} class="nav-link">
            <span class="lang-en">Dashboard</span>
            <span class="lang-pt">Início</span>
          </a>
          <a href={`${base}/groups`} class="nav-link">
            <span class="lang-en">Groups</span>
            <span class="lang-pt">Grupos</span>
          </a>
          <a href={`${base}/matches`} class="nav-link">
            <span class="lang-en">Matches</span>
            <span class="lang-pt">Partidas</span>
          </a>
        </div>
        <div class="ml-auto flex items-center gap-4">
          <span class="text-xs text-gray-500 hidden sm:block">
            <span class="lang-en">Data updated daily · 10:00 BRT</span>
            <span class="lang-pt">Dados atualizados diariamente · 10:00 BRT</span>
          </span>
          <button
            id="lang-toggle"
            class="text-xs border border-night-600 rounded px-2 py-1 text-gray-400 hover:text-white hover:border-night-500 transition-colors font-mono"
            title="Mudar idioma / Switch language"
          >
            <span class="lang-en">PT-BR</span>
            <span class="lang-pt">EN</span>
          </button>
          <a href="https://talesmiguel.dev/" target="_blank" rel="noopener noreferrer" class="nav-link">Portfolio</a>
        </div>
      </nav>
    </header>

    <main class="px-6 py-8">
      <slot />
    </main>

    <footer class="border-t border-night-700 mt-16 py-6 text-center text-xs text-gray-600">
      <p>
        <span class="lang-en">Data sourced from FIFA APIs · Built by</span>
        <span class="lang-pt">Dados da API da FIFA · Desenvolvido por</span>
        {' '}<a href="https://talesmiguel.dev" class="text-fifa-green hover:underline">TalesMiguel</a>
      </p>
    </footer>

    <script is:inline>
      document.getElementById('lang-toggle').addEventListener('click', function() {
        var html = document.documentElement;
        var next = (html.getAttribute('data-lang') || 'en') === 'en' ? 'pt' : 'en';
        html.setAttribute('data-lang', next);
        localStorage.setItem('lang', next);
      });
    </script>
  </body>
</html>

<style is:global>
  .nav-link {
    @apply text-sm text-gray-400 hover:text-white px-3 py-1.5 rounded-md hover:bg-night-700 transition-colors;
  }

  .lang-pt { display: none; }
  [data-lang="pt"] .lang-en { display: none; }
  [data-lang="pt"] .lang-pt { display: inline; }
</style>
