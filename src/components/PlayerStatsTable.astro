---
import type { PlayerStat } from '../types';

interface Props {
  players: PlayerStat[];
  homeTeamId: string;
}

const { players, homeTeamId } = Astro.props;

const homePlayers = players.filter(p => p.teamId === homeTeamId).sort((a, b) => b.timePlayed - a.timePlayed);
const awayPlayers = players.filter(p => p.teamId !== homeTeamId).sort((a, b) => b.timePlayed - a.timePlayed);

const positionLabel: Record<string, string> = {
  Goalkeeper: 'GK',
  Defender: 'DEF',
  Midfielder: 'MID',
  Forward: 'FWD',
};

function fmt(n: number | undefined | null, decimals = 0) {
  if (n == null || isNaN(n)) return '—';
  return decimals > 0 ? n.toFixed(decimals) : String(Math.round(n));
}

function fmtDist(m: number | undefined | null) {
  if (m == null || isNaN(m)) return '—';
  return (m / 1000).toFixed(1) + ' km';
}

const sections = [
  { labelEN: 'Home', labelPT: 'Casa', rows: homePlayers },
  { labelEN: 'Away', labelPT: 'Fora', rows: awayPlayers },
];
---

{sections.map(({ labelEN, labelPT, rows }) => (
  <div class="mb-6">
    <h4 class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-2">
      <span class="lang-en">{labelEN}</span>
      <span class="lang-pt">{labelPT}</span>
    </h4>
    <div class="overflow-x-auto">
      <table class="w-full text-xs" style="table-layout: fixed">
        <colgroup>
          <col style="width: 1.5rem" />
          <col />
          <col style="width: 2.75rem" />
          <col style="width: 2.75rem" />
          <col style="width: 1.75rem" />
          <col style="width: 1.75rem" />
          <col style="width: 3rem" />
          <col style="width: 2.5rem" />
          <col style="width: 3.25rem" />
          <col style="width: 3.75rem" />
          <col style="width: 2.5rem" />
        </colgroup>
        <thead>
          <tr class="text-gray-500 border-b border-night-700">
            <th class="text-left pb-2 pr-3 font-medium">#</th>
            <th class="text-left pb-2 pr-3 font-medium">
              <span class="lang-en">Player</span>
              <span class="lang-pt">Jogador</span>
            </th>
            <th class="text-left pb-2 pr-3 font-medium">
              <span class="lang-en">Pos</span>
              <span class="lang-pt">Pos</span>
            </th>
            <th class="text-right pb-2 pr-3 font-medium">Min</th>
            <th class="text-right pb-2 pr-3 font-medium">G</th>
            <th class="text-right pb-2 pr-3 font-medium">A</th>
            <th class="text-right pb-2 pr-3 font-medium">
              <span class="lang-en">Shots</span>
              <span class="lang-pt">Chutes</span>
            </th>
            <th class="text-right pb-2 pr-3 font-medium">SoT</th>
            <th class="text-right pb-2 pr-3 font-medium">Pass%</th>
            <th class="text-right pb-2 pr-3 font-medium">Dist</th>
            <th class="text-right pb-2 pr-3 font-medium">xG</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-night-700/50">
          {rows.map(p => {
            const passAcc = p.passes > 0 ? (p.passesCompleted / p.passes * 100) : null;
            return (
              <tr class="hover:bg-night-700/30 transition-colors">
                <td class="py-1.5 pr-3 text-gray-600 tabular-nums">{p.shirtNumber}</td>
                <td class="py-1.5 pr-3 font-medium text-white">{p.playerName}</td>
                <td class="py-1.5 pr-3 text-gray-500">{positionLabel[p.position] ?? p.position}</td>
                <td class="py-1.5 pr-3 text-right tabular-nums text-gray-400">{fmt(p.timePlayed)}'</td>
                <td class="py-1.5 pr-3 text-right tabular-nums">{p.goals > 0 ? <span class="text-fifa-green font-bold">{p.goals}</span> : <span class="text-gray-600">0</span>}</td>
                <td class="py-1.5 pr-3 text-right tabular-nums">{p.assists > 0 ? <span class="text-fifa-gold">{p.assists}</span> : <span class="text-gray-600">0</span>}</td>
                <td class="py-1.5 pr-3 text-right tabular-nums text-gray-400">{fmt(p.attemptAtGoal)}</td>
                <td class="py-1.5 pr-3 text-right tabular-nums text-gray-400">{fmt(p.attemptAtGoalOnTarget)}</td>
                <td class="py-1.5 pr-3 text-right tabular-nums text-gray-400">{passAcc != null ? fmt(passAcc) + '%' : '—'}</td>
                <td class="py-1.5 pr-3 text-right tabular-nums text-gray-400">{fmtDist(p.totalDistance)}</td>
                <td class="py-1.5 text-right tabular-nums text-gray-400">{p.xg > 0 ? fmt(p.xg, 2) : '—'}</td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  </div>
))}
