---
import type { Match } from '../types';

interface Props {
  match: Match;
  compact?: boolean;
}

const { match, compact = false } = Astro.props;
const base = import.meta.env.BASE_URL;

const isFinished = match.homeScore !== null && match.homeScore !== undefined;
const isScheduled = !isFinished;

const dateObj = new Date(match.date);
const dateFmt = dateObj.toLocaleDateString('en-GB', { day: '2-digit', month: 'short' });
const timeFmt = dateObj.toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit', timeZone: 'America/Sao_Paulo' });
---

<a
  href={isFinished ? `${base}/match/${match.idMatch}` : '#'}
  class:list={[
    'block rounded-xl border transition-all',
    isFinished
      ? 'border-night-600 bg-night-800 hover:border-fifa-green/40 hover:bg-night-700 cursor-pointer'
      : 'border-night-700 bg-night-800/50 cursor-default',
    compact ? 'p-3' : 'p-4',
  ]}
>
  <div class="flex items-center justify-between gap-3">
    <!-- Home team -->
    <div class="flex items-center gap-2 flex-1 min-w-0">
      <span class:list={['font-semibold truncate', compact ? 'text-sm' : 'text-base']}>
        {match.homeTeam.abbreviation}
      </span>
    </div>

    <!-- Score / time -->
    <div class="flex flex-col items-center shrink-0">
      {isFinished ? (
        <div class="flex items-center gap-1.5">
          <span class="text-xl font-bold tabular-nums">{match.homeScore}</span>
          <span class="text-gray-500 text-sm">–</span>
          <span class="text-xl font-bold tabular-nums">{match.awayScore}</span>
        </div>
      ) : (
        <div class="text-center">
          <div class="text-sm font-mono text-fifa-green">{timeFmt}</div>
          <div class="text-xs text-gray-500">BRT</div>
        </div>
      )}
      {!compact && (
        <div class="text-xs text-gray-600 mt-0.5">{dateFmt}</div>
      )}
    </div>

    <!-- Away team -->
    <div class="flex items-center gap-2 flex-1 min-w-0 justify-end">
      <span class:list={['font-semibold truncate', compact ? 'text-sm' : 'text-base']}>
        {match.awayTeam.abbreviation}
      </span>
    </div>
  </div>

  {!compact && isFinished && match.goals.length > 0 && (() => {
    const parseMin = (m: string) => parseInt(m.replace(/\D/g, '')) || 0;
    const homeGoals = match.goals.filter(g => g.teamId === match.homeTeam.id).sort((a, b) => parseMin(a.minute) - parseMin(b.minute));
    const awayGoals = match.goals.filter(g => g.teamId === match.awayTeam.id).sort((a, b) => parseMin(a.minute) - parseMin(b.minute));
    return (
      <div class="mt-2 pt-2 border-t border-night-700 text-xs text-gray-500">
        <div class="flex gap-4">
          <div class="flex-1 space-y-0.5 text-right">
            {homeGoals.map(g => (
              <div>{g.playerName} <span class="font-mono text-gray-600">{g.minute}</span></div>
            ))}
          </div>
          <div class="flex-1 space-y-0.5">
            {awayGoals.map(g => (
              <div><span class="font-mono text-gray-600">{g.minute}</span> {g.playerName}</div>
            ))}
          </div>
        </div>
      </div>
    );
  })()}

  {!compact && !isFinished && (
    <div class="mt-1.5 text-xs text-gray-600 text-center">{match.stageName}</div>
  )}
</a>
