---
import Layout from '../layouts/Layout.astro';
import MatchCard from '../components/MatchCard.astro';
import GroupTable from '../components/GroupTable.astro';
import type { Match, GroupStanding } from '../types';
import { readFileSync } from 'fs';
import { resolve } from 'path';

let matches: Match[] = [];
let standings: GroupStanding[] = [];

try {
  matches = JSON.parse(readFileSync(resolve('data/matches.json'), 'utf-8'));
  standings = JSON.parse(readFileSync(resolve('data/standings.json'), 'utf-8'));
} catch {
  // data not yet fetched — CI will have it
}

const now = new Date();
const yesterday = new Date(now); yesterday.setDate(yesterday.getDate() - 1);
const tomorrow = new Date(now); tomorrow.setDate(tomorrow.getDate() + 1);

// Yesterday in BRT (UTC-3): build runs at 10:00 BRT so "yesterday" is well-defined
const BRT_OFFSET_MS = -3 * 60 * 60 * 1000;
const todayBRT = new Date(now.getTime() + BRT_OFFSET_MS);
todayBRT.setUTCHours(0, 0, 0, 0);
const yesterdayBRT = new Date(todayBRT.getTime() - 24 * 60 * 60 * 1000);

const recent = matches
  .filter(m => {
    if (m.homeScore === null || m.homeScore === undefined) return false;
    const t = new Date(m.date).getTime() + BRT_OFFSET_MS;
    return t >= yesterdayBRT.getTime() && t < todayBRT.getTime();
  })
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());

const upcoming = matches
  .filter(m => (m.homeScore === null || m.homeScore === undefined) && new Date(m.date) >= now)
  .sort((a, b) => new Date(a.date).getTime() - new Date(b.date).getTime())
  .slice(0, 6);

// Group stage only standings, first 6 groups for dashboard
const dashboardGroups = standings.slice(0, 6);
---

<Layout title="Dashboard">
  <div class="space-y-10">

    <!-- Hero -->
    <div class="text-center py-6">
      <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight">
        <span class="text-white">
          <span class="lang-en">FIFA World Cup</span>
          <span class="lang-pt">Copa do Mundo FIFA</span>
        </span>
        <span class="text-fifa-gold"> 2026</span>
      </h1>
      <p class="text-gray-500 mt-2 text-sm">
        <span class="lang-en">Canada · Mexico · United States</span>
        <span class="lang-pt">Canadá · México · Estados Unidos</span>
      </p>
    </div>

    <!-- Recent Results + Upcoming -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">

      <section>
        <h2 class="section-title">
          <span class="lang-en">Recent Results</span>
          <span class="lang-pt">Resultados Recentes</span>
        </h2>
        {recent.length > 0 ? (
          <div class="space-y-2">
            {recent.map(m => <MatchCard match={m} />)}
          </div>
        ) : (
          <p class="text-gray-600 text-sm">
            <span class="lang-en">No matches played yet.</span>
            <span class="lang-pt">Nenhuma partida disputada ainda.</span>
          </p>
        )}
      </section>

      <section>
        <h2 class="section-title">
          <span class="lang-en">Upcoming</span>
          <span class="lang-pt">Próximas Partidas</span>
        </h2>
        {upcoming.length > 0 ? (
          <div class="space-y-2">
            {upcoming.map(m => <MatchCard match={m} />)}
          </div>
        ) : (
          <p class="text-gray-600 text-sm">
            <span class="lang-en">No upcoming matches.</span>
            <span class="lang-pt">Nenhuma partida futura.</span>
          </p>
        )}
      </section>

    </div>

    <!-- Group Standings (first 6) -->
    {dashboardGroups.length > 0 && (
      <section>
        <div class="flex items-center justify-between mb-4">
          <h2 class="section-title mb-0">
            <span class="lang-en">Group Standings</span>
            <span class="lang-pt">Classificação dos Grupos</span>
          </h2>
          <a href={`${import.meta.env.BASE_URL}groups`} class="text-xs text-fifa-green hover:underline">
            <span class="lang-en">See all 12 groups →</span>
            <span class="lang-pt">Ver todos os 12 grupos →</span>
          </a>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-4">
          {dashboardGroups.map(g => <GroupTable group={g} compact />)}
        </div>
      </section>
    )}

  </div>
</Layout>

<style is:global>
  .section-title {
    @apply text-sm font-semibold text-gray-400 uppercase tracking-wider mb-3;
  }
</style>
