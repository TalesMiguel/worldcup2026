---
import Layout from '../layouts/Layout.astro';
import MatchCard from '../components/MatchCard.astro';
import type { Match } from '../types';
import { readFileSync } from 'fs';
import { resolve } from 'path';

let matches: Match[] = [];
try {
  matches = JSON.parse(readFileSync(resolve('data/matches.json'), 'utf-8'));
} catch { }

const finished = matches
  .filter(m => m.homeScore !== null && m.homeScore !== undefined)
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());

const upcoming = matches
  .filter(m => m.homeScore === null || m.homeScore === undefined)
  .sort((a, b) => new Date(a.date).getTime() - new Date(b.date).getTime());

// Group upcoming by stage
const upcomingStages = [...new Set(upcoming.map(m => m.stageName))];
const upcomingByStage = upcomingStages.map(stage => ({
  stage,
  matches: upcoming.filter(m => m.stageName === stage),
}));
---

<Layout title="Matches">
  <div class="space-y-10">
    <h1 class="text-2xl font-bold">Matches</h1>

    {matches.length === 0 && (
      <p class="text-gray-500">Match data will appear after the first data update.</p>
    )}

    {finished.length > 0 && (
      <section>
        <h2 class="text-sm font-semibold text-gray-400 uppercase tracking-wider mb-4 border-b border-night-700 pb-2">
          Results
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
          {finished.map(m => <MatchCard match={m} />)}
        </div>
      </section>
    )}

    {upcomingByStage.map(({ stage, matches: stageMatches }) => (
      <section>
        <h2 class="text-sm font-semibold text-gray-400 uppercase tracking-wider mb-4 border-b border-night-700 pb-2">
          {stage}
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
          {stageMatches.map(m => <MatchCard match={m} />)}
        </div>
      </section>
    ))}
  </div>
</Layout>
