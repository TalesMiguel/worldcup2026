---
import Layout from '../../layouts/Layout.astro';
import PlayerStatsTable from '../../components/PlayerStatsTable.astro';
import type { Match, MatchDetail, PlayerStat, TeamStat } from '../../types';
import { readFileSync, existsSync } from 'fs';
import { resolve } from 'path';
import { teamNames, stageNames, groupNamePt } from '../../i18n/maps';

export function getStaticPaths() {
  try {
    const matches: Match[] = JSON.parse(readFileSync(resolve('data/matches.json'), 'utf-8'));
    return matches
      .filter(m => m.homeScore !== null && m.homeScore !== undefined)
      .map(m => ({ params: { id: m.idMatch } }));
  } catch {
    return [];
  }
}

const { id } = Astro.params;

let matches: Match[] = [];
try {
  matches = JSON.parse(readFileSync(resolve('data/matches.json'), 'utf-8'));
} catch { }

const match = matches.find(m => m.idMatch === id);
if (!match) return Astro.redirect(import.meta.env.BASE_URL);

// Load player + team stats if available
let playerStats: PlayerStat[] = [];
let homeTeamStat: TeamStat | null = null;
let awayTeamStat: TeamStat | null = null;

const playersFile = resolve(`data/stats/${match.idIFES}_players.json`);
const teamsFile = resolve(`data/stats/${match.idIFES}_teams.json`);

if (existsSync(playersFile)) {
  playerStats = JSON.parse(readFileSync(playersFile, 'utf-8'));
}
if (existsSync(teamsFile)) {
  const teamsData = JSON.parse(readFileSync(teamsFile, 'utf-8'));
  homeTeamStat = teamsData[match.homeTeam.id] ?? null;
  awayTeamStat = teamsData[match.awayTeam.id] ?? null;
}

const dateObj = new Date(match.date);
const dateFmtEN = dateObj.toLocaleDateString('en-GB', {
  weekday: 'long', day: 'numeric', month: 'long', year: 'numeric',
  timeZone: 'America/Sao_Paulo',
});
const dateFmtPT = dateObj.toLocaleDateString('pt-BR', {
  weekday: 'long', day: 'numeric', month: 'long', year: 'numeric',
  timeZone: 'America/Sao_Paulo',
});
const timeFmt = dateObj.toLocaleTimeString('en-GB', {
  hour: '2-digit', minute: '2-digit', timeZone: 'America/Sao_Paulo',
});

const cardLabel: Record<number, string> = { 1: '🟨', 2: '🟥', 3: '🟨🟥' };

function fmtStat(n: number | undefined | null, unit = '') {
  if (n == null) return '—';
  return Math.round(n) + unit;
}
function pct(a: number, b: number) {
  if (!b) return '—';
  return Math.round(a / b * 100) + '%';
}

const homeNamePt = teamNames[match.homeTeam.name] ?? match.homeTeam.name;
const awayNamePt = teamNames[match.awayTeam.name] ?? match.awayTeam.name;
const stageNamePt = stageNames[match.stageName] ?? match.stageName;
const groupNamePtVal = match.groupName ? groupNamePt(`Group ${match.groupName}`) : '';

const teamStatRows = [
  { labelEN: 'Shots', labelPT: 'Chutes', home: homeTeamStat?.attemptAtGoal, away: awayTeamStat?.attemptAtGoal },
  { labelEN: 'Goals', labelPT: 'Gols', home: homeTeamStat?.goals, away: awayTeamStat?.goals },
  { labelEN: 'Passes', labelPT: 'Passes', home: homeTeamStat?.passes, away: awayTeamStat?.passes },
  { labelEN: 'Pass Accuracy', labelPT: 'Precisão de Passe', home: homeTeamStat ? pct(homeTeamStat.passesCompleted, homeTeamStat.passes) : '—', away: awayTeamStat ? pct(awayTeamStat.passesCompleted, awayTeamStat.passes) : '—' },
  { labelEN: 'Corners', labelPT: 'Escanteios', home: homeTeamStat?.corners, away: awayTeamStat?.corners },
  { labelEN: 'Yellow Cards', labelPT: 'Cartões Amarelos', home: homeTeamStat?.yellowCards, away: awayTeamStat?.yellowCards },
  { labelEN: 'Red Cards', labelPT: 'Cartões Vermelhos', home: homeTeamStat?.redCards, away: awayTeamStat?.redCards },
];

// Tactical comparison: each row's bar width is home's share of (home + away).
function barPct(home: number | undefined, away: number | undefined) {
  const h = home ?? 0, a = away ?? 0;
  if (h + a === 0) return 50;
  return Math.round(h / (h + a) * 100);
}

const tacticalRows = homeTeamStat && awayTeamStat ? [
  { labelEN: 'Possession', labelPT: 'Posse de Bola', home: homeTeamStat.possession, away: awayTeamStat.possession, unit: '%' },
  { labelEN: 'Ball Progressions', labelPT: 'Progressões de Bola', home: homeTeamStat.ballProgressionsCompleted, away: awayTeamStat.ballProgressionsCompleted },
  { labelEN: 'Switches of Play', labelPT: 'Mudanças de Lado', home: homeTeamStat.switchesOfPlayCompleted, away: awayTeamStat.switchesOfPlayCompleted },
  { labelEN: 'Crosses Completed', labelPT: 'Cruzamentos Certos', home: homeTeamStat.crossesCompleted, away: awayTeamStat.crossesCompleted },
  { labelEN: 'Line Breaks', labelPT: 'Quebras de Linha', home: homeTeamStat.lineBreaksCompleted, away: awayTeamStat.lineBreaksCompleted },
  { labelEN: 'Line Breaks — Attacking Third', labelPT: 'Quebras de Linha — Terço de Ataque', home: homeTeamStat.lineBreaksAttackingLineCompleted, away: awayTeamStat.lineBreaksAttackingLineCompleted },
  { labelEN: 'Line Breaks — Midfield', labelPT: 'Quebras de Linha — Meio-Campo', home: homeTeamStat.lineBreaksMidfieldLineCompleted, away: awayTeamStat.lineBreaksMidfieldLineCompleted },
  { labelEN: 'Line Breaks — Defensive Third', labelPT: 'Quebras de Linha — Terço de Defesa', home: homeTeamStat.lineBreaksDefensiveLineCompleted, away: awayTeamStat.lineBreaksDefensiveLineCompleted },
  { labelEN: 'Defensive Pressures Applied', labelPT: 'Pressões Defensivas Aplicadas', home: homeTeamStat.defensivePressuresApplied, away: awayTeamStat.defensivePressuresApplied },
  { labelEN: 'Forced Turnovers', labelPT: 'Posses Forçadas', home: homeTeamStat.forcedTurnovers, away: awayTeamStat.forcedTurnovers },
] : [];
---

<Layout title={`${match.homeTeam.abbreviation} vs ${match.awayTeam.abbreviation}`}>
  <div class="space-y-8">

    <!-- Back link -->
    <a href={`${import.meta.env.BASE_URL}matches`} class="text-xs text-gray-500 hover:text-white flex items-center gap-1">
      <span class="lang-en">← Back to matches</span>
      <span class="lang-pt">← Voltar para partidas</span>
    </a>

    <!-- Match header -->
    <div class="rounded-2xl border border-night-600 bg-night-800 p-6">
      <div class="text-center text-xs text-gray-500 mb-4">
        <span class="lang-en">{match.stageName}{match.groupName ? ` · Group ${match.groupName}` : ''}</span>
        <span class="lang-pt">{stageNamePt}{match.groupName ? ` · ${groupNamePtVal}` : ''}</span>
        <span class="mx-2">·</span>
        <span class="lang-en">{dateFmtEN}</span>
        <span class="lang-pt">{dateFmtPT}</span>
        {' '}· {timeFmt} BRT
      </div>

      <div class="flex items-center justify-center gap-6 sm:gap-12">
        <div class="text-center flex-1">
          <div class="text-2xl sm:text-3xl font-extrabold">{match.homeTeam.abbreviation}</div>
          <div class="text-xs text-gray-500 mt-1 truncate">
            <span class="lang-en">{match.homeTeam.name}</span>
            <span class="lang-pt">{homeNamePt}</span>
          </div>
        </div>

        <div class="text-center shrink-0">
          <div class="text-5xl sm:text-6xl font-black tabular-nums text-white tracking-tight">
            {match.homeScore}<span class="text-gray-600 mx-1">–</span>{match.awayScore}
          </div>
          <div class="text-xs text-fifa-green mt-2 font-semibold uppercase tracking-wider">
            <span class="lang-en">Full Time</span>
            <span class="lang-pt">Fim de Jogo</span>
          </div>
        </div>

        <div class="text-center flex-1">
          <div class="text-2xl sm:text-3xl font-extrabold">{match.awayTeam.abbreviation}</div>
          <div class="text-xs text-gray-500 mt-1 truncate">
            <span class="lang-en">{match.awayTeam.name}</span>
            <span class="lang-pt">{awayNamePt}</span>
          </div>
        </div>
      </div>

      <!-- Goals timeline -->
      {match.goals.length > 0 && (
        <div class="mt-6 pt-4 border-t border-night-700">
          <div class="flex gap-4 text-sm">
            <div class="flex-1 space-y-1 text-right">
              {match.goals.filter(g => g.teamId === match.homeTeam.id).map(g => (
                <div class="text-gray-300">
                  {g.playerName} <span class="text-gray-500 font-mono text-xs">{g.minute}</span>
                </div>
              ))}
            </div>
            <div class="text-gray-600 pt-0.5 shrink-0">⚽</div>
            <div class="flex-1 space-y-1">
              {match.goals.filter(g => g.teamId === match.awayTeam.id).map(g => (
                <div class="text-gray-300">
                  <span class="text-gray-500 font-mono text-xs">{g.minute}</span> {g.playerName}
                </div>
              ))}
            </div>
          </div>
        </div>
      )}
    </div>

    <!-- Team stats comparison -->
    {homeTeamStat && awayTeamStat && (
      <section>
        <h2 class="section-title">
          <span class="lang-en">Team Stats</span>
          <span class="lang-pt">Estatísticas do Time</span>
        </h2>
        <div class="rounded-xl border border-night-600 bg-night-800 divide-y divide-night-700">
          {teamStatRows.map(({ labelEN, labelPT, home, away }) => (
            <div class="flex items-center px-4 py-2.5 text-sm">
              <span class="w-12 text-right font-semibold tabular-nums">{home}</span>
              <span class="flex-1 text-center text-xs text-gray-500">
                <span class="lang-en">{labelEN}</span>
                <span class="lang-pt">{labelPT}</span>
              </span>
              <span class="w-12 text-left font-semibold tabular-nums">{away}</span>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- Tactical stats comparison -->
    {tacticalRows.length > 0 && (
      <section>
        <h2 class="section-title">
          <span class="lang-en">Tactical Stats</span>
          <span class="lang-pt">Estatísticas Táticas</span>
        </h2>
        <div class="rounded-xl border border-night-600 bg-night-800 divide-y divide-night-700">
          {tacticalRows.map(({ labelEN, labelPT, home, away, unit }) => (
            <div class="px-4 py-2.5 text-sm">
              <div class="flex items-center mb-1.5">
                <span class="w-14 text-right font-semibold tabular-nums">{fmtStat(home, unit ?? '')}</span>
                <span class="flex-1 text-center text-xs text-gray-500 px-2">
                  <span class="lang-en">{labelEN}</span>
                  <span class="lang-pt">{labelPT}</span>
                </span>
                <span class="w-14 text-left font-semibold tabular-nums">{fmtStat(away, unit ?? '')}</span>
              </div>
              <div class="flex h-1.5 rounded-full overflow-hidden bg-night-700">
                <div class="bg-fifa-green" style={`width: ${barPct(home, away)}%`}></div>
                <div class="bg-orange-500" style={`width: ${100 - barPct(home, away)}%`}></div>
              </div>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- Bookings -->
    {match.bookings.length > 0 && (
      <section>
        <h2 class="section-title">
          <span class="lang-en">Bookings</span>
          <span class="lang-pt">Cartões</span>
        </h2>
        <div class="flex flex-wrap gap-2">
          {match.bookings.map(b => (
            <div class="text-xs bg-night-800 border border-night-600 rounded-lg px-3 py-1.5 flex items-center gap-1.5">
              <span>{cardLabel[b.card] ?? '🟨'}</span>
              <span class="font-medium">{b.playerName}</span>
              <span class="text-gray-500 font-mono">{b.minute}</span>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- Player stats -->
    {playerStats.length > 0 && (
      <section>
        <h2 class="section-title">
          <span class="lang-en">Player Stats</span>
          <span class="lang-pt">Estatísticas dos Jogadores</span>
        </h2>
        <PlayerStatsTable players={playerStats} homeTeamId={match.homeTeam.id} />
      </section>
    )}

    {playerStats.length === 0 && (
      <p class="text-gray-600 text-sm">
        <span class="lang-en">Detailed player stats will appear after the next data update.</span>
        <span class="lang-pt">Estatísticas detalhadas dos jogadores aparecerão após a próxima atualização.</span>
      </p>
    )}

  </div>
</Layout>

<style is:global>
  .section-title {
    @apply text-sm font-semibold text-gray-400 uppercase tracking-wider mb-3;
  }
</style>
